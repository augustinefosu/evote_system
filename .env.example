# ---------------------------------------------------------------------------
# University E-Voting System — environment template
# Copy to .env and replace every secret before running outside a demo.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Path to the legacy SQLite database file. The application no longer uses
# SQLite; this remains only for `npm run backup`'s legacy path and for
# migrating an existing evoting.db by hand. Ignored by the server.
DB_PATH=./evoting.db

# --- Supabase (REQUIRED for the Postgres backend) ----------------------------
# Setup: project dashboard -> Database -> Connection string (URI), and
# Settings -> API. Then apply supabase/schema.sql once in the SQL Editor.
#
# Copy the whole URI. The database password MUST be percent-encoded, because
# Supabase passwords often contain characters (@ : / ? #) that otherwise break
# the URI. Encode them by hand, or run:
#   node -e "console.log(encodeURIComponent(process.argv[1]))" 'YOUR-PASSWORD'
#
# Prefer the Supavisor *pooler* URI over the direct db.<ref>.supabase.co one.
# The direct hostname is IPv6-only and fails with ENOTFOUND/ETIMEDOUT on
# networks without IPv6; the pooler hostname also works over IPv4. Use the
# transaction-mode port 6543 (not 5432) with a pool.
#
# Both values are secrets. Never commit .env, and never send either to the
# browser: the service role key bypasses Row Level Security entirely.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# Postgres connection. EITHER a full URI...
SUPABASE_DB_URL=postgresql://postgres.PROJECT-REF:URL-ENCODED-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# ...OR the discrete parts (used only when SUPABASE_DB_URL is empty):
# SUPABASE_DB_HOST=db.YOUR-PROJECT-REF.supabase.co
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PASSWORD=your-database-password

# TLS verification. Defaults to full verification. Supabase's certificate is
# usually absent from the host's CA bundle, so full verification fails with
# "self-signed certificate in certificate chain". This includes Netlify
# Functions — set SUPABASE_DB_SSL=no-verify there or the first DB query in any
# request rejects and the platform returns an opaque 502.
SUPABASE_DB_SSL=no-verify

# Optional, and the secure alternative to no-verify: paste Supabase's root CA
# (Project Settings -> Database -> SSL configuration) to verify the server
# certificate properly. Literal "\n" escapes in a single-line value are
# accepted. When set, this takes precedence over SUPABASE_DB_SSL.
# SUPABASE_DB_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Maximum pooled Postgres connections. Supabase's pooler caps the project
# total, so keep this modest.
SUPABASE_DB_POOL=10

# Optional: name of a PUBLIC Supabase Storage bucket for candidate photos.
# When set (together with the URL and key above) uploads go to Storage instead
# of the local uploads/ directory. Required on serverless hosts (Netlify), whose
# filesystem is read-only and ephemeral. Create the bucket once, marked public
# for reads; leave this unset for local development and the test suites.
# SUPABASE_STORAGE_BUCKET=candidate-photos

# Public base URL of the deployment. Used in verification and notification links.
APP_URL=http://localhost:3000

# --- Proxy ------------------------------------------------------------------
# How many reverse proxies sit in front of the app. Defaults to 1 (correct for
# Netlify Functions, Render and a single Nginx/Caddy). Without this, rate
# limiting and audit logs see the proxy's IP for every visitor, so per-IP limits
# become global. Raise it if the host adds more hops; must be an exact match.
# TRUST_PROXY=1

# --- Secrets (REQUIRED in production) ---------------------------------------
# MUST be a long random value (32+ characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to start in production if this is missing or still the
# placeholder below, so a known value can never reach a live deployment.
JWT_SECRET=change-me-to-a-long-random-secret-in-production-min-32-chars
JWT_EXPIRES_IN=12h

# One-time key required by POST /api/setup/superadmin to create the very first
# super administrator. Generate a fresh random value for each deployment and
# delete it once bootstrap is complete.
ADMIN_SETUP_KEY=change-me-to-a-fresh-random-bootstrap-key

# --- CORS --------------------------------------------------------------------
# Comma-separated list of allowed browser origins. Same-origin requests are
# always permitted; this only matters if a separate frontend is used.
# Leave unset in production unless a second origin genuinely needs access.
# CORS_ORIGINS=https://election.university.edu

# --- Email (optional) -------------------------------------------------------
# When SMTP is unset the mailer logs messages instead of sending them and
# notifications remain visible in-app, so the system is fully functional
# without a mail provider. Configure these to deliver real email.
# SMTP_HOST=smtp.example.edu
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=secret
# MAIL_FROM=University E-Voting <no-reply@university.edu>

# --- Background jobs --------------------------------------------------------
# How often the scheduler checks for elections whose start/end time has passed.
# SCHEDULER_MS=60000

# --- Tests ------------------------------------------------------------------
# `npm test` requires a real Postgres server. Each test file creates its own
# throwaway database, applies supabase/schema.sql, and drops the database when
# it finishes, so the tests are isolated and can run in parallel.
#
# Point this at a LOCAL or disposable Postgres. Do NOT point it at the Supabase
# project used in SUPABASE_DB_URL above: the test run CREATES and DROPS
# databases and would delete real data.
# TEST_PG_ADMIN_URL=postgresql://postgres:your-local-password@127.0.0.1:5432/postgres
